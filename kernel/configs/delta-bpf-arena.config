#
# Kernel config fragment for bpf-arena-data-structures.
#
# Merge into an existing .config with the kernel's own tooling:
#
#   cd /path/to/linux
#   ./scripts/kconfig/merge_config.sh -m .config /path/to/bpf-arena.config
#   make olddefconfig
#
# Or drop it into the kernel tree and use the built-in target:
#
#   cp bpf-arena.config /path/to/linux/kernel/configs/
#   cd /path/to/linux && make bpf-arena.config
#
# Then confirm the derived symbols came out right:
#
#   python3 scripts/check_kconfig.py /path/to/linux/.config
#
# This file lists ONLY user-settable symbols (ones with a Kconfig prompt).
# Symbols that are def_bool/select-only -- BPF, BPF_EVENTS, UPROBES,
# BPF_JIT_DEFAULT_ON, DYNAMIC_FTRACE_WITH_DIRECT_CALLS, DEBUG_INFO, 64BIT,
# MMU -- are pulled in automatically and are checked by check_kconfig.py
# rather than set here. Setting them directly would just be overwritten by
# olddefconfig.
#

# ---------------------------------------------------------------------------
# BPF arena (BPF_MAP_TYPE_ARENA)
#
# There is no CONFIG_BPF_ARENA. Upstream kernel/bpf/Makefile has:
#     ifeq ($(CONFIG_MMU)$(CONFIG_64BIT),yy)
#     obj-$(CONFIG_BPF_SYSCALL) += arena.o range_tree.o
#     endif
# so arena support follows from BPF_SYSCALL on any 64-bit MMU arch.
# The JIT is required for the addr_space_cast instructions the arena
# data structures compile down to.
# ---------------------------------------------------------------------------
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y

# ---------------------------------------------------------------------------
# BPF LSM -- the kernel-side producer, SEC("lsm.s/inode_create")
# ---------------------------------------------------------------------------
CONFIG_SECURITY=y
CONFIG_BPF_LSM=y

# CONFIG_LSM must contain "bpf" or the lsm.s programs fail to attach at
# runtime even with CONFIG_BPF_LSM=y. The list below is the superset from
# the reference 6.18.2 build. If your distro sets a narrower list, keep
# your entries and append ",bpf" instead of taking this line wholesale.
# Alternative without a rebuild: boot with lsm=<your list>,bpf
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,integrity,apparmor,selinux,smack,tomoyo,bpf,ipe"

# ---------------------------------------------------------------------------
# uprobes -- the return-lane consumer, SEC("uprobe.s"), attached via
# bpf_program__attach_uprobe_opts() on *_kernel_consume_trigger()
# ---------------------------------------------------------------------------
CONFIG_PERF_EVENTS=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_UPROBE_EVENTS=y

# ---------------------------------------------------------------------------
# BPF trampoline -- backs the fentry-style attach used by both lsm.s and
# uprobe.s programs. Also provides trace_pipe for bpf_printk() under -v.
# ---------------------------------------------------------------------------
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_DYNAMIC_FTRACE=y

# ---------------------------------------------------------------------------
# BTF -- libbpf CO-RE relocations and BTF-typed program attach both read
# /sys/kernel/btf/vmlinux at load time.
#
# DEBUG_INFO itself has no prompt; it turns on by picking any DWARF choice
# other than "None". DEBUG_INFO_BTF additionally depends on
# !DEBUG_INFO_SPLIT && !DEBUG_INFO_REDUCED, so both are pinned off here.
# ---------------------------------------------------------------------------
# CONFIG_DEBUG_INFO_NONE is not set
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
# CONFIG_DEBUG_INFO_REDUCED is not set
# CONFIG_DEBUG_INFO_SPLIT is not set
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y

# ---------------------------------------------------------------------------
# OPTIONAL: kcov and io_uring
#
# Not required to build or run anything currently in src/. The kcov and
# io_uring skeletons are arena rings modeled on those subsystems' designs
# -- src/skeleton_kcov.c never opens /sys/kernel/debug/kcov and
# src/skeleton_io_uring.c never calls io_uring_setup() or links liburing.
# The reference 6.18.2 kernel ran the full suite with KCOV off entirely.
#
# Enabled here so a single kernel covers comparisons against the real
# subsystems (e.g. a liburing-backed relay variant) without a rebuild.
# ---------------------------------------------------------------------------
CONFIG_IO_URING=y

# Requires ARCH_HAS_KCOV (x86-64, arm64, and others). KCOV pulls in
# DEBUG_FS automatically.
CONFIG_KCOV=y

# KCOV_INSTRUMENT_ALL defaults to y and instruments *every* kernel
# function with coverage callbacks. That is a large, uneven overhead on
# exactly the paths this repo measures, so it is pinned off -- leaving it
# on will distort the latency and throughput numbers from ds_metrics.
# Turn it back on only for an explicitly coverage-oriented build.
# CONFIG_KCOV_INSTRUMENT_ALL is not set
